# Hosted/public Streamlit deployment.
# Never commit real secrets. Paste values into Streamlit App settings -> Secrets.

CLOUDFLARE_ACCOUNT_ID = "replace-with-account-id"
CLOUDFLARE_API_TOKEN = "replace-with-workers-ai-token"
CLOUDFLARE_GENERATOR_MODEL = "@cf/google/gemma-4-26b-a4b-it"
CLOUDFLARE_ROUTER_MODEL = "@cf/zai-org/glm-4.7-flash"
CLOUDFLARE_EMBEDDING_MODEL = "@cf/baai/bge-small-en-v1.5"
CLOUDFLARE_RERANKER_MODEL = "@cf/baai/bge-reranker-base"
USE_CLOUDFLARE_RETRIEVAL = "true"

USE_SUPABASE = "true"
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_replace-me"

# Optional paid fallback:
# OPENAI_API_KEY = "replace-with-key"
# OPENAI_MODEL = "gpt-5.6-luna"

# Never put SUPABASE_SECRET_KEY in the public Streamlit deployment.
