# Hosted/public Streamlit deployment.
# Never commit real secrets. Paste these values into Streamlit App settings -> Secrets.

OPENAI_API_KEY = "replace-with-project-scoped-key"
OPENAI_MODEL = "gpt-5.6-luna"

# Optional but recommended production persistence/vector backend.
USE_SUPABASE = "true"
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_replace-me"

# Do NOT put SUPABASE_SECRET_KEY in Streamlit secrets.
# Use it only in a trusted local/admin environment to run scripts/sync_supabase.py.
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY names are also supported.
