# Cloudflare Workers AI (optional; local generation otherwise uses Ollama)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.2-3b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base
USE_CLOUDFLARE_RETRIEVAL=true

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Supabase runtime. Enable only after the project is created and seeded.
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase admin sync only. Never commit a real value.
SUPABASE_SECRET_KEY=
