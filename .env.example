# Optional OpenAI hosted generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Supabase runtime (low-privilege)
USE_SUPABASE=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# Supabase admin sync only. Never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_
