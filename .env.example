# Local LLM defaults to Ollama; these enable free hosted generation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.2-3b-instruct

# Optional paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Supabase runtime (low-privilege)
USE_SUPABASE=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# Supabase admin sync only. Never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_
